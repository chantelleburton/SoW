[scheduler]
    allow implicit tasks = True

[task parameters]
    member = 1..15
    country = Chile, Canada, Iberia#, Scotland, Korea
    index = ffmc, fwi, isi, bui, dmc, dc
[scheduling]

    [[graph]]
        R1 = """
            hadgem_historical_fwi<member,country,index>
        """

[runtime]
    [[hadgem_historical_fwi<member,country,index>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/Historical_FWI/
        python HadGEM3_Historical_FWI.py
        """

        platform = spice

        [[[directives]]]
            --mem = 4G
            --time = 10
            --cpus-per-task = 1
            --ntasks = 1