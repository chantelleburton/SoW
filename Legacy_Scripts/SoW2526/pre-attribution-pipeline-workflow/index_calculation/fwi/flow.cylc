#!Jinja2
{# Generate all 525 attribution-ensemble member IDs (r001i1p1 .. r105i1p5), #}
{# matching HadGEM3-A_Attribution/flow.cylc. #}
{% set N_RUNS = 105 %}
{% set N_PHYSICS = 5 %}
{% set attr_members = [] %}
{% for r in range(1, N_RUNS + 1) %}
{%   for p in range(1, N_PHYSICS + 1) %}
{%     do attr_members.append('r%03di1p%d' | format(r, p)) %}
{%   endfor %}
{% endfor %}

# Unified flow: runs the ERA5, HadGEM3-A Attribution and HadGEM3-A Historical
# FWI calculations together. Each part can also still be run standalone from
# its own flow.cylc in ERA5/, HadGEM3-A_Attribution/ and HadGEM3-A_Historical/.
# Task parameters below are namespaced per source (era5_*, attr_*, hist_*) to
# avoid collisions, then mapped back onto the plain CYLC_TASK_PARAM_* names
# each script expects via an export in its runtime script.

[scheduler]
    allow implicit tasks = True

[task parameters]
    era5_start_year = 1979, 1989, 1999, 2009, 2019
    era5_wind_stat = mean#, max
    era5_rh_stat = mean#, minimum

    attr_run_type = historicalExt, historicalNatExt
    attr_member = {{ attr_members | join(', ') }}

    hist_member = 1..15

[scheduling]
    [[graph]]
        R1 = """
            era5_fwi_calculation<era5_start_year, era5_wind_stat, era5_rh_stat>
            hadgem_attribution_fwi_calculation<attr_run_type, attr_member>
            hadgem_historical_fwi_calculation<hist_member>
        """

[runtime]
    [[era5_fwi_calculation<era5_start_year, era5_wind_stat, era5_rh_stat>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/index_calculation/fwi/FWI-ERA5/
        export CYLC_TASK_PARAM_start_year=${CYLC_TASK_PARAM_era5_start_year}
        export CYLC_TASK_PARAM_wind_stat=${CYLC_TASK_PARAM_era5_wind_stat}
        export CYLC_TASK_PARAM_rh_stat=${CYLC_TASK_PARAM_era5_rh_stat}
        echo "Running start_year=${CYLC_TASK_PARAM_start_year} wind_stat=${CYLC_TASK_PARAM_wind_stat} rh_stat=${CYLC_TASK_PARAM_rh_stat}"
        python era5_fwi_calculation.py
        """

        platform = spice

        [[[directives]]]
            --mem = 150G
            --partition = cpu-long
            --time = 720
            --cpus-per-task = 4
            --ntasks = 1

    [[hadgem_attribution_fwi_calculation<attr_run_type, attr_member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/index_calculation/fwi/FWI-HadGEM3-A_Attribution/
        export CYLC_TASK_PARAM_run_type=${CYLC_TASK_PARAM_attr_run_type}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_attr_member}
        echo "Running run_type=${CYLC_TASK_PARAM_run_type} member=${CYLC_TASK_PARAM_member}"
        python hadgem3-a_attribution_fwi_calculation.py
        """

        platform = spice

        [[[directives]]]
            --mem = 20G
            --partition = cpu-long
            --time = 240
            --cpus-per-task = 4
            --ntasks = 1

    [[hadgem_historical_fwi_calculation<hist_member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/index_calculation/fwi/FWI-HadGEM3-A_Historical/
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_hist_member}
        echo "Running member=${CYLC_TASK_PARAM_member}"
        python hadgem3-a_historical_fwi_calculation.py
        """

        platform = spice

        [[[directives]]]
            --mem = 20G
            --partition = cpu-long
            --time = 240
            --cpus-per-task = 4
            --ntasks = 1
