
[scheduler]
    allow implicit tasks = True

[task parameters]

    member = 1..15
[scheduling]
    [[graph]]
        R1 = """
            hadgem_historical_fwi_calculation<member>
        """

[runtime]
    [[hadgem_historical_fwi_calculation<member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/index_calculation/fwi/FWI-HadGEM3-A_Historical
        echo "Running member=${CYLC_TASK_PARAM_member}"
        python hadgem3-a_historical_fwi_calculation.py
        """

        platform = spice

        [[[directives]]]
            --mem = 100G
            --partition = cpu
            --time = 150
            --cpus-per-task = 4
            --ntasks = 1