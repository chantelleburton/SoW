#!Jinja2
{# Generate all 525 attribution-ensemble member IDs (r001i1p1 .. r105i1p5). #}
{% set N_RUNS = 105 %}
{% set N_PHYSICS = 5 %}
{% set attr_members = [] %}
{% for r in range(1, N_RUNS + 1) %}
{%   for p in range(1, N_PHYSICS + 1) %}
{%     do attr_members.append('r%03di1p%d' | format(r, p)) %}
{%   endfor %}
{% endfor %}

# Flow for the interim-metrics stage (attribution_pipeline/metrics/run_metrics.py).
# Turns the daily FWI/DSR NetCDF files produced by the FWI-creation stage into
# per-year, event-month metric CSVs consumed by bias correction and the ERA5
# threshold lookup.
#
# Three dataset families, each a separate task because their parameter spaces
# differ (ERA5 has no members but has run_label; hg3_historical has 15 baseline
# members; hg3_attribution has 525 members x 2 run types). Comment out any line
# in [scheduling][[graph]] to run a subset.
#
# To add a metric (e.g. dsr p95, fwi 7x, dsr cumulative) add rows to the
# met_* task parameters below — no code change needed, run_metrics.py resolves
# the metric from its METRICS registry.

[scheduler]
    allow implicit tasks = True

[task parameters]
    country = Korea, Iberia, Scotland, Chile, Canada

    # index x metric combinations to compute. Keep these aligned across the
    # three datasets so bias correction always finds a matching baseline +
    # ensemble metric CSV.
    index = fwi, dsr
    metric = p95, 7x, cum

    era5_run_label = Mean_RH_Mean_Wind

    hist_member = 1..15

    attr_run_type = historicalExt, historicalNatExt
    attr_member = {{ attr_members | join(', ') }}

[scheduling]
    [[graph]]
        R1 = """
            era5_metrics<country, index, metric, era5_run_label>
            hist_metrics<country, index, metric, hist_member>
            attr_metrics<country, index, metric, attr_run_type, attr_member>
        """

[runtime]
    [[era5_metrics<country, index, metric, era5_run_label>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code
        export CYLC_TASK_PARAM_dataset=era5
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_run_label=${CYLC_TASK_PARAM_era5_run_label}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 30G
            --partition = cpu
            --time = 120
            --cpus-per-task = 2
            --ntasks = 1

    [[hist_metrics<country, index, metric, hist_member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code
        export CYLC_TASK_PARAM_dataset=hg3_historical
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_hist_member}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 20G
            --partition = cpu
            --time = 120
            --cpus-per-task = 2
            --ntasks = 1

    [[attr_metrics<country, index, metric, attr_run_type, attr_member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code
        export CYLC_TASK_PARAM_dataset=hg3_attribution
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_run_type=${CYLC_TASK_PARAM_attr_run_type}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_attr_member}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 15G
            --partition = cpu
            --time = 60
            --cpus-per-task = 2
            --ntasks = 1
