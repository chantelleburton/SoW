#!Jinja2
{# Generate all 525 attribution-ensemble member IDs (r001i1p1 .. r105i1p5). #}
{# N_RUNS/N_PHYSICS come from rose-suite.conf [jinja2:suite.rc]. #}
{% set attr_members = [] %}
{% for r in range(1, N_RUNS + 1) %}
{%   for p in range(1, N_PHYSICS + 1) %}
{%     do attr_members.append('r%03di1p%d' | format(r, p)) %}
{%   endfor %}
{% endfor %}

# Flow for the interim-metrics stage (attribution_pipeline/metrics/run_metrics.py).
# Turns the daily FWI/DSR NetCDF files produced by the FWI-creation stage into
# per-year, event-month metric CSVs consumed by bias correction and the ERA5
# threshold lookup.
#
# Four dataset families, each a separate task because their parameter spaces
# differ (ERA5 has no members but has run_label; hg3_historical_xclim has 15
# baseline members and fwi/dsr; hg3_historical_impacttb also has 15 baseline
# members but FWI only (no DSR -- impact-toolbox data doesn't have it);
# hg3_attribution has 525 members x 2 run types). Comment out any line
# in [scheduling][[graph]] to run a subset.
#
# To add a metric (e.g. dsr p95, fwi 7x, dsr cumulative) add rows to the
# METRIC value in the sibling rose-suite.conf -- no code change needed,
# run_metrics.py resolves the metric from its METRICS registry.
#
# All tunable values (task-parameter lists, ensemble geometry, and
# CODE_DIR) live in the sibling rose-suite.conf -- edit that file to
# reconfigure this workflow rather than this file.
{% set CODE_DIR = environ.get('ATTRIBUTION_PIPELINE_CODE_DIR', '/data/users/bob.potts/StateOfFires_2025-26/code') %}

[scheduler]
    allow implicit tasks = True

# Country/region config (REGION_CONFIGS) now lives in
# attribution_pipeline/pipeline_config.py (shared across all four
# subpackages), not this metrics/ stage specifically.

[task parameters]
    country = {{ COUNTRY | join(', ') }}

    # index x metric combinations to compute. Keep these aligned across the
    # three datasets so bias correction always finds a matching baseline +
    # ensemble metric CSV.
    index = {{ INDEX | join(', ') }}
    metric = {{ METRIC | join(', ') }}

    era5_run_label = {{ ERA5_RUN_LABEL }}

    hist_member = {{ HIST_MEMBER }}

    attr_run_type = {{ ATTR_RUN_TYPE | join(', ') }}
    attr_member = {{ attr_members | join(', ') }}

[runtime]
    [[root]]
        [[[environment]]]
            CODE_DIR = {{ CODE_DIR }}

[scheduling]
    [[graph]]
        R1 = """
            era5_metrics<country, index, metric, era5_run_label>
            histxclim_metrics<country, index, metric, hist_member>
            histimpacttb_metrics<country, metric, hist_member>
            #attr_metrics<country, index, metric, attr_run_type, attr_member>
        """ #attr metrics only exists for diagnostic purposes if a deeper dive into the 
        #attribution ensemble is needed should downstream results be off.
        # histimpacttb_metrics has no 'index' parameter -- impact-toolbox historical
        # data is FWI only (no DSR), unlike histxclim_metrics/era5_metrics/attr_metrics.

[runtime]
    [[era5_metrics<country, index, metric, era5_run_label>]]
        script = """
        set -eux
        conda activate sowf
        cd $CODE_DIR
        export CYLC_TASK_PARAM_dataset=era5
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_run_label=${CYLC_TASK_PARAM_era5_run_label}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 30G
            --partition = cpu
            --time = 120
            --cpus-per-task = 2
            --ntasks = 1

    [[histxclim_metrics<country, index, metric, hist_member>]]
        script = """
        set -eux
        conda activate sowf
        cd $CODE_DIR
        export CYLC_TASK_PARAM_dataset=hg3_historical_xclim
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_hist_member}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 20G
            --partition = cpu
            --time = 120
            --cpus-per-task = 2
            --ntasks = 1

    [[histimpacttb_metrics<country, metric, hist_member>]]
        script = """
        set -eux
        conda activate sowf
        cd $CODE_DIR
        export CYLC_TASK_PARAM_dataset=hg3_historical_impacttb
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=fwi
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_hist_member}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 20G
            --partition = cpu
            --time = 120
            --cpus-per-task = 2
            --ntasks = 1

    [[attr_metrics<country, index, metric, attr_run_type, attr_member>]]
        script = """
        set -eux
        conda activate sowf
        cd $CODE_DIR
        export CYLC_TASK_PARAM_dataset=hg3_attribution
        export CYLC_TASK_PARAM_country=${CYLC_TASK_PARAM_country}
        export CYLC_TASK_PARAM_index=${CYLC_TASK_PARAM_index}
        export CYLC_TASK_PARAM_metric=${CYLC_TASK_PARAM_metric}
        export CYLC_TASK_PARAM_run_type=${CYLC_TASK_PARAM_attr_run_type}
        export CYLC_TASK_PARAM_member=${CYLC_TASK_PARAM_attr_member}
        python -m attribution_pipeline.metrics.run_metrics
        """

        platform = spice

        [[[directives]]]
            --mem = 15G
            --partition = cpu
            --time = 60
            --cpus-per-task = 2
            --ntasks = 1
