#!Jinja2
{# Generate all 525 ensemble member IDs (r001i1p1 .. r105i1p5).                #}
{# Each task computes daily, per-grid-cell raw FWI diffs (Xclim - ImpactTB)   #}
{# for one member/experiment across the 3 primary focal regions; the script  #}
{# skips (exit 0) when that member is absent from either dataset.            #}
{% set N_RUNS = 5 %}
{% set N_PHYSICS = 5 %}
{% set members = [] %}
{% for r in range(1, N_RUNS + 1) %}
{%   for p in range(1, N_PHYSICS + 1) %}
{%     do members.append('r%03di1p%d' | format(r, p)) %}
{%   endfor %}
{% endfor %}

[scheduler]
    allow implicit tasks = True

[task parameters]
    run_type = historicalExt, historicalNatExt
    member = {{ members | join(', ') }}

[scheduling]
    [[graph]]
        R1 = """
            compute_raw_fwi_diffs<run_type, member> => aggregate_raw_fwi_diffs
        """

[runtime]
    [[compute_raw_fwi_diffs<run_type, member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/Exploratory_Work/xclim_work/attribution_ensemble/validation/raw_fwi_diffs/
        echo "Computing raw FWI diffs run_type=${CYLC_TASK_PARAM_run_type} member=${CYLC_TASK_PARAM_member}"
        python compute_raw_fwi_diffs.py
        """

        platform = spice

        [[[directives]]]
            --mem = 8G
            --partition = cpu
            --time = 90
            --cpus-per-task = 2
            --ntasks = 1

    [[aggregate_raw_fwi_diffs]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/Exploratory_Work/xclim_work/attribution_ensemble/validation/raw_fwi_diffs/
        echo "Aggregating per-member raw FWI diff outputs"
        python aggregate_raw_fwi_diffs.py
        """

        platform = spice

        [[[directives]]]
            --mem = 12G
            --partition = cpu
            --time = 30
            --cpus-per-task = 1
            --ntasks = 1
