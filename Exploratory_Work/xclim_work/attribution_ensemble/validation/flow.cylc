#!Jinja2
{# Generate all 525 ensemble member IDs (r001i1p1 .. r105i1p5) so they don't #}
{# have to be typed by hand. N_RUNS x N_PHYSICS realisations.                 #}
{# Each task validates one member/experiment; the script skips (exit 0) when  #}
{# that member is absent from either the ImpactTB or Xclim dataset.           #}
{% set N_RUNS = 105 %}
{% set N_PHYSICS = 5 %}
{% set members = [] %}
{% for r in range(1, N_RUNS + 1) %}
{%   for p in range(1, N_PHYSICS + 1) %}
{%     do members.append('r%03di1p%d' | format(r, p)) %}
{%   endfor %}
{% endfor %}

[scheduler]
    allow implicit tasks = True

[task parameters]
    run_type = historicalExt, historicalNatExt
    member = {{ members | join(', ') }}

[scheduling]
    [[graph]]
        R1 = """
            compare_fwi95<run_type, member> => aggregate_fwi95
        """

[runtime]
    [[compare_fwi95<run_type, member>]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/Exploratory_Work/xclim_work/attribution_ensemble/validation/
        echo "Validating run_type=${CYLC_TASK_PARAM_run_type} member=${CYLC_TASK_PARAM_member}"
        python compare_fwi95_timeseries.py
        """

        platform = spice

        [[[directives]]]
            --mem = 5G
            --partition = cpu
            --time = 60
            --cpus-per-task = 2
            --ntasks = 1

    [[aggregate_fwi95]]
        script = """
        set -eux
        conda activate sowf
        cd /data/users/bob.potts/StateOfFires_2025-26/code/Exploratory_Work/xclim_work/attribution_ensemble/validation/
        echo "Aggregating per-member FWI95 validation outputs"
        python aggregate_fwi95.py
        """

        platform = spice

        [[[directives]]]
            --mem = 8G
            --partition = cpu
            --time = 20
            --cpus-per-task = 1
            --ntasks = 1
